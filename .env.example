# Server-only configuration. Demo works without an API key and makes no paid calls.
# Choose demo or ai explicitly; AI errors never substitute Demo results.
BUNDLELAB_MODE=demo
# Required only in AI Mode. Put the real value in .env.local or Vercel settings.
# Never prefix credentials with NEXT_PUBLIC_ or commit local environment files.
OPENAI_API_KEY=
# Optional server-side model override; requires structured output support.
OPENAI_MODEL=gpt-4.1-mini
